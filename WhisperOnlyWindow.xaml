<Window x:Class="whisperMeOff.WhisperOnlyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="whisperMeOff - Whisper Only"
        Height="380" Width="500"
        Background="#FAFAFA"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{x:Null}" CommandParameter="{Binding}"/>
    </Window.InputBindings>
    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Whisper Only Mode" FontSize="24" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="2" Text="Click the microphone button, press F5, or Ctrl+Shift+R to start voice recognition. The transcribed text will be copied to your clipboard automatically." FontSize="13" Foreground="#666666" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="400"/>
        
        <!-- VU Meter -->
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <ProgressBar x:Name="VuMeter" Height="20" Minimum="0" Maximum="100" Value="0" 
                        Background="#E0E0E0" Foreground="#0078D4" BorderThickness="0"/>
        </Grid>
        
        <TextBlock x:Name="StatusText" Grid.Row="6" Text="Ready" FontSize="14" Foreground="#666666" HorizontalAlignment="Center"/>
        <Button x:Name="MicButton" Grid.Row="8" Style="{StaticResource ModernButton}" Content="MIC" Click="MicButton_Click" Width="100" Height="100" FontSize="24" ToolTip="Click or press F5 to start voice input"/>
    </Grid>
</Window>
