<Window x:Class="whisperMeOff.VuMeterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recording"
        Width="320" Height="70"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Window.Resources>
        <LinearGradientBrush x:Key="WaveGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00FF88" Offset="0"/>
            <GradientStop Color="#00CCFF" Offset="0.5"/>
            <GradientStop Color="#FF00AA" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>
    
    <Border Background="#DD000000" CornerRadius="20" Padding="10,5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Recording indicator -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                <Ellipse x:Name="RecordingDot" Width="8" Height="8" Margin="0,0,6,0">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF6666" Offset="0"/>
                            <GradientStop Color="#FF4444" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock x:Name="StatusText" Text="Recording" Foreground="#AAAAAA" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
            
            <!-- Waveform display using Canvas -->
            <Canvas x:Name="WaveformCanvas" Grid.Row="1" ClipToBounds="True"/>
            
            <!-- Progress bar for transcription/enhancement -->
            <ProgressBar x:Name="TranscribeProgress" Grid.Row="2" Height="4" Minimum="0" Maximum="100" Value="0" 
                        Background="#444444" Foreground="#28A745" BorderThickness="0" Margin="0,4,0,0" Visibility="Collapsed"/>
        </Grid>
    </Border>
</Window>
